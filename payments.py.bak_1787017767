            _save_crypto(c)
            context.user_data.pop("pay_flow", None)
            kb = InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Back", callback_data="pay:c:" + cid)]])
            await update.message.reply_text("✅ Emoji removed from crypto.", reply_markup=kb)
        else:
            c["emoji_id"] = text
            _save_crypto(c)
            context.user_data.pop("pay_flow", None)
            kb = InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Back", callback_data="pay:c:" + cid)]])
            await update.message.reply_text(f"✅ Animated emoji set for {c['name']}!\n\nID: {text}", reply_markup=kb)
        raise ApplicationHandlerStop

    if step == "set_pay_image":
        if text == "0":
            set_pay_image(None)
            context.user_data.pop("pay_flow", None)
            kb = InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Back", callback_data="pay:admin")]])
            await update.message.reply_text("🖼️ Payment image removed.", reply_markup=kb)
        else:
            await update.message.reply_text("Please send a photo, or send 0 to remove it.")
        raise ApplicationHandlerStop

    if step == "edit_picker_text":
        set_picker_text(text)
        context.user_data.pop("pay_flow", None)
        kb = InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Back", callback_data="pay:admin")]])
        await update.message.reply_text("✅ Crypto-choosing page text updated.", reply_markup=kb)
        raise ApplicationHandlerStop

    if step == "add_symbol":
        wait = await update.message.reply_text("🔄 Checking OxaPay's supported currencies…")
        try:
            data = await _supported_currencies()
        except Exception as e:
            context.user_data.pop("pay_flow", None)
            await wait.edit_text("⚠️ Could not reach OxaPay: " + html.escape(str(e)))
            raise ApplicationHandlerStop
        symbol, info = _find_currency(data, text)
        if not symbol:
            sample = ", ".join(sorted([k for k, v in data.items() if v.get("status", True)])[:40])
            await wait.edit_text(
                "❌ '" + html.escape(text) + "' is not a currently active OxaPay currency." + NL + NL
                + "Some valid symbols: " + html.escape(sample) + NL + NL
                + "Send another symbol, or go 🔙 Back."
            )
            raise ApplicationHandlerStop
        networks = info.get("networks") or {}
        if len(networks) <= 1:
            network_key = next(iter(networks.keys()), None)
            context.user_data["pay_flow"] = {"step": "add_name", "symbol": symbol, "network": network_key}
            await wait.edit_text(
                "✅ Found <b>" + symbol + "</b>" + (" on " + network_key if network_key else "") + "." + NL + NL
                + "Now send a display NAME for it (example: " + symbol + "):",
                parse_mode="HTML",
            )
            raise ApplicationHandlerStop
        kb = []
        for net_key, net_info in networks.items():
            label = net_info.get("name") or net_key
            kb.append([InlineKeyboardButton(label, callback_data="pay:addnet:" + symbol + ":" + net_key)])
        kb.append([InlineKeyboardButton("🔙 Back", callback_data="pay:admin")])
        await wait.edit_text(
            "✅ Found <b>" + symbol + "</b>. Pick the network:", parse_mode="HTML",
            reply_markup=InlineKeyboardMarkup(kb),
        )
        raise ApplicationHandlerStop

    if step == "add_name":
        symbol = flow["symbol"]
        network_key = flow.get("network")
        new = {
            "id": _new_id(),
            "name": text,
            "enabled": True,
            "oxapay_currency": symbol,
            "oxapay_network": network_key,
            "emoji_id": None,
        }
        data_all = load_cryptos()
        data_all["cryptos"].append(new)
        save_cryptos(data_all)
        context.user_data.pop("pay_flow", None)
        kb = InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Back", callback_data="pay:admin")]])
        await update.message.reply_text("✅ Added '" + text + "' (" + symbol + (" / " + network_key if network_key else "") + ") and enabled it.", reply_markup=kb)
        raise ApplicationHandlerStop

    if step == "lookup_track":
        merchant_key = get_merchant_key()
        context.user_data.pop("pay_flow", None)
        if not merchant_key:
            await update.message.reply_text("No merchant key configured.")
            raise ApplicationHandlerStop
        wait = await update.message.reply_text("🔄 Looking up payment…")
        try:
            data = await oxapay_client.get_payment(merchant_key, text)
        except OxaPayError as e:
            await wait.edit_text("❌ " + html.escape(str(e)))
            raise ApplicationHandlerStop
        pretty = json.dumps(data, indent=2, ensure_ascii=False)[:3500]
        kb = InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Back", callback_data="pay:admin")]])
        await wait.edit_text("<pre>" + html.escape(pretty) + "</pre>", parse_mode="HTML", reply_markup=kb)
        raise ApplicationHandlerStop

    return

def _new_id():
    import uuid
    return uuid.uuid4().hex[:8]

# ========================= PHOTO INPUT =========================
async def _on_photo(update, context):
    flow = context.user_data.get("pay_flow")
    if not flow or flow.get("step") != "set_pay_image":
        return
    if update.effective_user.id != ADMIN_ID:
        return
    file_id = update.message.photo[-1].file_id
    set_pay_image(file_id)
    context.user_data.pop("pay_flow", None)
    kb = InlineKeyboardMarkup([[InlineKeyboardButton("🔙 Back", callback_data="pay:admin")]])
    await update.message.reply_text("✅ Payment image updated.", reply_markup=kb)
    raise ApplicationHandlerStop

# ========================= /payments COMMAND =========================
async def _cmd_payments(update, context):
    if update.effective_user.id != ADMIN_ID:
        return
    context.user_data.pop("pay_flow", None)
    text, kb = admin_home_panel()
    await update.message.reply_text(text, reply_markup=kb, parse_mode="HTML")

