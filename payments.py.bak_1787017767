async def begin_payment_from_cart(query, context):
    user_id = query.from_user.id
    try:
        import cart
        items = cart._get_cart(user_id)
        usd = cart._cart_total(items)
    except Exception:
        items, usd = [], 0.0
    if not items:
        await _render_buyer_raw(query, context, "<b>🛒 Your cart is empty.</b>",
                                [[{"text": "Back", "callback_data": "cart:open"}]])
        return
    await _begin_payment_raw(query, context, [dict(it) for it in items], usd, source="cart")

async def begin_payment_buynow(query, context, item):
    user_id = query.from_user.id
    try:
        import cart
        usd = cart._line_total(item)
    except Exception:
        usd = 0.0
    await _begin_payment_raw(query, context, [dict(item)], usd, source="buynow")

async def _begin_payment_raw(query, context, items, usd, source="cart"):
    user_id = query.from_user.id
    if not items:
        await _render_buyer_raw(query, context, "<b>❌ Nothing to pay for.</b>",
                                [[{"text": "Back", "callback_data": "cart:open"}]])
        return
    if not enabled_cryptos():
        await _render_buyer_raw(query, context,
                                "<b>⚠️ Payment is not available right now.</b>" + NL
                                + "No cryptocurrency is configured. Please contact support.",
                                [[{"text": "Back", "callback_data": "cart:open"}]])
        return
    label = ", ".join((it.get("title", "Order") + " (x" + str(it.get("qty", 1)) + ")") for it in items)
    _cancel_task(user_id)
    _cancel_poll(user_id)
    context.user_data["pay_order"] = {"state": "choosing", "label": label, "usd": float(usd),
                                      "charge_usd": float(usd), "wallet_used": 0.0,
                                      "user_id": user_id, "items": [dict(it) for it in items],
                                      "source": source}
    bal = _wallet_balance(user_id)
    text, keyboard_rows, photo = _picker_screen_raw(_is_admin(user_id), show_wallet=True, wallet_balance=bal)
    await _render_buyer_raw(query, context, text, keyboard_rows, photo)

async def _on_pick_raw(query, context, cid):
    user_id = query.from_user.id
    order = context.user_data.get("pay_order")
    if not order:
        await query.answer("Session expired, please start again", show_alert=True)
        return
    crypto = get_crypto(cid)
    if not crypto or not crypto.get("enabled") or not crypto.get("oxapay_currency"):
        await query.answer("That option is unavailable", show_alert=True)
        return

    merchant_key = get_merchant_key()
    if not merchant_key:
        await query.answer("Payments are not configured yet. Please contact support.", show_alert=True)
        return

    charge = float(order.get("charge_usd", order.get("usd", 0)))
    await query.answer("Generating your payment address…")

    try:
        res = await oxapay_client.create_white_label(
            merchant_key,
            amount_usd=charge,
            pay_currency=crypto["oxapay_currency"],
            network=crypto.get("oxapay_network"),
            order_id=f"{user_id}-{int(time.time())}",
            lifetime_minutes=DEFAULT_LIFETIME_MINUTES,
            description=(order.get("label") or "Order")[:250],
        )
    except OxaPayError as e:
        await context.bot.send_message(query.message.chat_id, "⚠️ Could not create the payment (" + html.escape(str(e)) + "). Please try again or pick another crypto.")
        return

    track_id = res.get("track_id")
    address = res.get("address")
    if not track_id or not address:
        await context.bot.send_message(query.message.chat_id, "⚠️ OxaPay didn't return a payment address. Please try again.")
        return

    order.update({
        "state": "await_payment", "cid": cid,
        "crypto_name": crypto["name"],
        "track_id": track_id,
        "address": address,
        "memo": res.get("memo") or None,
        "pay_amount": res.get("pay_amount"),
        "pay_currency": res.get("pay_currency") or crypto["oxapay_currency"],
        "network_name": res.get("network") or crypto.get("oxapay_network") or "",
        "deadline": float(res.get("expired_at") or (time.time() + DEFAULT_LIFETIME_MINUTES * 60)),
        "started_at": time.time(),
        "chat_id": query.message.chat_id, "msg_id": query.message.message_id,
        "has_photo": bool(query.message.photo),
        "poll_errors": 0,
    })
    context.user_data["pay_order"] = order
    remaining = int(order["deadline"] - time.time())
    text = _payment_detail_text(order, remaining)
    await _edit_live_raw(context, order["chat_id"], order["msg_id"], order["has_photo"], text)
    _spawn(user_id, _countdown_raw(context, user_id))
    _spawn_poll(user_id, _poll_status_raw(context, user_id))

def _payment_detail_text(order, remaining):
    amt = html.escape(_amount_display(order))
    lines = [
        "<b>📦 Product :</b> " + html.escape(order.get("label", "Wallet Deposit")),
        "",
        "<b>🪙 Pay With :</b> " + html.escape(order.get("crypto_name", "")) +
        (" (" + html.escape(order.get("network_name", "")) + ")" if order.get("network_name") else ""),
        "",
        "<b>💰 Amount :</b> " + amt,
        "",
        "<b>⏱️ Time Left :</b> " + _mmss(remaining),
        "",
        "⏰ Kindly Send The Funds Before The Timer Runs Out. This Address Is Unique To Your Order - Do Not Reuse It.",
        "",
        "Please Send Exactly <b>" + amt + "</b> To:",
        "<code>" + html.escape(order["address"]) + "</code>",
    ]
    if order.get("memo"):
        lines += ["", "⚠️ <b>Memo / Tag (required):</b>", "<code>" + html.escape(order["memo"]) + "</code>",
                   "Sending without this memo may result in permanent loss of funds."]
    return NL.join(lines)

async def _countdown_raw(context, user_id):
    try:
        while True:
            order = context.user_data.get("pay_order")
            if not order or order.get("user_id") != user_id or order.get("state") != "await_payment":
                return
            remaining = int(order["deadline"] - time.time())
            if remaining <= 0:
                await _expire_order_raw(context, user_id)
                return
            text = _payment_detail_text(order, remaining)
            await _edit_live_raw(context, order["chat_id"], order["msg_id"], order["has_photo"], text)
            await asyncio.sleep(min(PAY_COUNTDOWN_TICK, max(1, remaining)))
    except asyncio.CancelledError:
        return
    except Exception:
        return

async def _poll_status_raw(context, user_id):
    """Ask OxaPay directly whether this order's track_id has been paid.
    This replaces all the manual blockchain-scanning / tx-hash logic."""
    merchant_key = get_merchant_key()
    try:
        while True:
            await asyncio.sleep(PAY_POLL_TICK)
            order = context.user_data.get("pay_order")
            if not order or order.get("user_id") != user_id:
                return
            if order.get("state") not in ("await_payment", "waiting_conf"):
                return
            track_id = order.get("track_id")
            if not track_id or not merchant_key:
                return

            try:
                data = await oxapay_client.get_payment(merchant_key, track_id)
                order["poll_errors"] = 0
            except OxaPayError as e:
                order["poll_errors"] = order.get("poll_errors", 0) + 1
                context.user_data["pay_order"] = order
                print(f"[poll_status] OxaPay error for track {track_id}: {e}")
                if order["poll_errors"] >= PAY_POLL_MAX_ERRORS:
                    return
                continue

            status = str((data or {}).get("status") or "").strip().lower()
            if not status:
                continue

            order = context.user_data.get("pay_order")
            if not order or order.get("user_id") != user_id:
                return

            if status in ("paid", "completed", "success"):
                _cancel_task(user_id)
                await _mark_received_raw(context, user_id, data)
                return
            if status in ("confirming", "waiting_confirmation", "processing"):
                if order.get("state") == "await_payment":
                    order["state"] = "waiting_conf"
                    context.user_data["pay_order"] = order
                    _cancel_task(user_id)
                    await _edit_live_raw(context, order["chat_id"], order["msg_id"], order["has_photo"], WAITING_TEXT)
                continue
            if status in ("expired",):
                await _expire_order_raw(context, user_id)
                return
            if status in ("failed", "cancelled", "canceled", "error"):
                await _fail_order_raw(context, user_id)
                return
            # any other in-progress status ("new", "waiting", etc.) -> keep polling
    except asyncio.CancelledError:
        return
    except Exception as e:
        print(f"[poll_status] Unexpected error for user {user_id}: {e}")
        return

async def _expire_order_raw(context, user_id):
    order = context.user_data.get("pay_order")
    if not order:
